diff --git a/build/targets.simulator.macos.mak b/build/targets.simulator.macos.mak
index 97a17940..0d9fed55 100644
--- a/build/targets.simulator.macos.mak
+++ b/build/targets.simulator.macos.mak
@@ -8,3 +8,20 @@ reload: default
 	$(Q) pgrep Epsilon && pkill -USR1 Epsilon || echo "No Epsilon executable running"
 	$(Q) cmd="open $(BUILD_DIR)/$(firstword $(HANDY_TARGETS)).$(firstword $(HANDY_TARGETS_EXTENSIONS)) --args --load-state-file /tmp/numworks.reload.nws";\
 	eval $$cmd || $$cmd
+
+# NumWorks macOS shell integration.
+# Builds the whole simulator as a static library so a native shell app can
+# link it into a single executable. The shell provides main() and calls
+# epsilon_main(), the renamed Epsilon entry point.
+ifdef NUMWORKS_INTEGRATION_DIR
+SFLAGS += -I$(NUMWORKS_INTEGRATION_DIR)
+$(call object_for,ion/src/simulator/shared/main.cpp): SFLAGS += -Dmain=epsilon_main
+
+.PHONY: libepsilon.a
+libepsilon.a: $(BUILD_DIR)/libepsilon.a
+
+$(BUILD_DIR)/libepsilon.a: $(call flavored_object_for,$(epsilon_src),)
+	$(call rule_label,LIBTOOL)
+	$(Q) rm -f $@
+	$(Q) xcrun libtool -static -no_warning_for_no_symbols -o $@ $^
+endif
